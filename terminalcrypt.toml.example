[terminalcrypt]
source = "binance"
initial_view = "markets"
selected_symbol = "BTC"
refresh_per_second = 2
rest_enabled = true
telegram_enabled = true
sqlite_enabled = false
sqlite_path = "data/terminalcrypt.sqlite3"
sqlite_batch_size = 100
log_file = "logs/terminalcrypt.log"
log_level = "INFO"
fg_interval = 300
global_interval = 120
news_interval = 180
# Trading features
warmup_enabled = true          # sembrar indicadores con velas históricas al arrancar
depth_enabled = true           # order book + trade tape del símbolo seleccionado (Binance)
portfolio_file = ""            # ruta a portfolio.json / .toml para seguimiento de P&L
